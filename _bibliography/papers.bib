@inproceedings{luo2027neuralintent,
  abbr            = {AAAI-27},
  bibtex_show     = {true},
  title           = {NeuralIntent: Bridging Noninvasive EEG and Embodied Foundation Models with Continuous Neural Intent Tokens},
  author          = {Luo, Xiaoqi and Gao, Weixiang and Zhang, Zhengnan and Xu, Taojie and Zhou, Mo and Shi, Xun and Gao, Yunyuan},
  booktitle       = {The Forty-First AAAI Conference on Artificial Intelligence (Under Review)},
  year            = {2027},
  html            = {https://openreview.net/forum?id=HD4GoLhMkq},
  abstract        = {Individuals with severe motor or communication impairments may retain clear object goals but lack a reliable way to convey them to assistive robots. We present NeuralIntent, a framework that maps noninvasive electroencephalography (EEG) into continuous Neural Intent Tokens (NITs) and calibrates them to condition an embodied foundation model. NeuralIntent maps the EEG-derived representation into the policy condition space through an embodiment-specific adapter. The EEG-derived representation specifies the target object, while the embodied policy generates the actions needed to interact with it. We introduce the Embodied Intent Grounding Benchmark (EIG-Bench). On THINGS-EEG2, Qwen3-VL Layer 6 supervision improves retrieval among 200 candidates from 25.27\% to 40.58\%. Under strict leave-one-subject-out evaluation, calibrated NITs achieve 48.13\% target selection accuracy. In a separate modular evaluation, the system achieves 65.63\% task success, with all correctly selected objects subsequently grasped and lifted.},
  keywords        = {EEG, brain-computer interface, neural intent token, embodied AI, VLA, assistive robotics},
  pdf             = {neuralintent_aaai27.pdf},
  preview         = {neuralintent.png},
  selected        = {true},
  additional_info = {. **First author** · AAAI-27 submission · *Under Review* · Submission 37074. Framework: **NeuralIntent**; benchmark: **EIG-Bench**.}
}

